{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "templates/**",
      "tests/**",
      "private/**",
      "reports/**",
      "data/**",
      "output_shorts/**",
      "output_carousel/**",
      "__pycache__/**",
      "*.py",
      "*.ipynb",
      "*.csv",
      "*.md",
      "*.mp4",
      "*.pkl",
      "*.command",
      "all_players.json",
      "all_clubs.json",
      "historical_careers.json",
      "config.json",
      "google-apps-script.js",
      ".agents/**"
    ],
    "redirects": [
      {
        "source": "/templates/top_transfers_template.html",
        "destination": "/games/top_transfers.html",
        "type": 301
      },
      {
        "source": "/templates/transfer_destination_template.html",
        "destination": "/games/transfer_destination.html",
        "type": 301
      },
      {
        "source": "/templates/top_scorers_template.html",
        "destination": "/games/top_scorers.html",
        "type": 301
      },
      {
        "source": "/templates/club_connect_template.html",
        "destination": "/games/club_connect.html",
        "type": 301
      },
      {
        "source": "/templates/player_chain_template.html",
        "destination": "/games/player_chain.html",
        "type": 301
      },
      {
        "source": "/templates/passport_fc_template.html",
        "destination": "/games/passport_fc.html",
        "type": 301
      },
      {
        "source": "/templates/**",
        "destination": "/",
        "type": 301
      }
    ]
  }
}

